<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>KURO Auto Archive</AssemblyName>
    <RootNamespace>KUROAutoArchiveNative</RootNamespace>
    <Version>1.0.26.0</Version>
    <FileVersion>1.0.26.0</FileVersion>
    <AssemblyVersion>1.0.26.0</AssemblyVersion>
    <Product>KURO Auto Archive</Product>
    <Company>KURO</Company>
    <Description>KURO Auto Archive native Windows test</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
